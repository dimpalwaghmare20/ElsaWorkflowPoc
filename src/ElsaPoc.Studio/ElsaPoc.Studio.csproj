<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Elsa.Api.Client" Version="3.10.2" />
    <PackageReference Include="Elsa.Studio" Version="3.10.2" />
    <PackageReference Include="Elsa.Studio.Authentication.ElsaIdentity.BlazorWasm" Version="3.10.2" />
    <PackageReference Include="Elsa.Studio.Authentication.ElsaIdentity.UI" Version="3.10.2" />
    <PackageReference Include="Elsa.Studio.Authentication.UI" Version="3.10.2" />
    <PackageReference Include="Elsa.Studio.Core.BlazorWasm" Version="3.10.2" />
    <PackageReference Include="Elsa.Studio.Localization.BlazorWasm" Version="3.10.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" PrivateAssets="all" />
  </ItemGroup>

</Project>
